# ==============================================================================
# LocalePak Environment Variables Template (.env.example)
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public - used on client and server)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here

# ------------------------------------------------------------------------------
# 2. Firebase Admin Configuration (Private - server-side only)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. Site & Branding Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.localepak.com
NEXT_PUBLIC_SITE_NAME=LocalePak
NEXT_PUBLIC_SITE_HOST=www.localepak.com

# ------------------------------------------------------------------------------
# 4. WhatsApp & Contact Information
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
WHATSAPP_BUSINESS_NUMBER=923001234567

# ------------------------------------------------------------------------------
# 5. Email Services
# ------------------------------------------------------------------------------
# Brevo API key (server-only) — used by /api/send-mail for ALL site mail
# (welcome / submission / approval / payment + admin notifications).
# Vercel: BREVO_API_KEY must be set (Production). Sender is the
# authenticated domain address noreply@localepak.com.
# Key rotated 2026-10-24 (Production scope) — a fresh deployment is required for the new value to take effect.
BREVO_API_KEY=<redacted>

# --- Legacy / unused below this line (kept for reference only) ---
# Resend & EmailJS
# Resend API for transactional business emails (/api/send-business-email)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL="LocalePak <onboarding@resend.dev>"

# EmailJS Configuration (Optional for client-side forms)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# ------------------------------------------------------------------------------
# 6. SEO & Real-time Search Engine Indexing (IndexNow)
# ------------------------------------------------------------------------------
INDEXNOW_API_KEY=your_indexnow_api_key_here
ADMIN_SECRET_KEY=your_admin_secret_key_here

# ------------------------------------------------------------------------------
# 7. Google AdSense
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-your_adsense_client_id_here

# ------------------------------------------------------------------------------
# 8. AI / SmartTalk Chatbot (OpenAI-compatible endpoint)
# ------------------------------------------------------------------------------
AI_INTEGRATIONS_OPENAI_API_KEY=your_openai_api_key_here
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 9. Admin Portal Authentication
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_ADMIN_PASSWORD=your_admin_password_here

# ------------------------------------------------------------------------------
# 10. Analytics & Monitoring
# ------------------------------------------------------------------------------
VERCEL_ANALYTICS_ID=your_vercel_analytics_id_here
